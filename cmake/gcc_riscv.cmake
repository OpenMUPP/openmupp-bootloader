# RISC-V toolchain file for the CH32V307 (QingKe V4F) boards. The toolchain
# is the xPack riscv-none-elf-gcc, or a toolchain with the same tool names.
# Give its install directory with -DGCC_TOOLCHAIN_PREFIX=<dir> or the
# environment variable RISCV_GCC_TOOLCHAIN_PREFIX.
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

get_filename_component(CMAKE_DIR ${CMAKE_CURRENT_LIST_FILE} DIRECTORY)
set(CMAKE_MODULE_PATH ${CMAKE_DIR} ${CMAKE_MODULE_PATH})

if(NOT TARGET_TRIPLET)
    set(TARGET_TRIPLET "riscv-none-elf")
endif()

if(NOT GCC_TOOLCHAIN_PREFIX)
    if(DEFINED ENV{RISCV_GCC_TOOLCHAIN_PREFIX})
        set(GCC_TOOLCHAIN_PREFIX "$ENV{RISCV_GCC_TOOLCHAIN_PREFIX}")
    else()
        find_program(_RISCV_GCC ${TARGET_TRIPLET}-gcc)
        if(_RISCV_GCC)
            get_filename_component(_RISCV_GCC_BIN "${_RISCV_GCC}" DIRECTORY)
            get_filename_component(GCC_TOOLCHAIN_PREFIX "${_RISCV_GCC_BIN}" DIRECTORY)
        else()
            set(GCC_TOOLCHAIN_PREFIX "/usr")
        endif()
    endif()
endif()
file(TO_CMAKE_PATH "${GCC_TOOLCHAIN_PREFIX}" GCC_TOOLCHAIN_PREFIX)
set(GCC_TOOLCHAIN_PREFIX "${GCC_TOOLCHAIN_PREFIX}" CACHE PATH "Install directory of the RISC-V GNU toolchain")

set(TOOLCHAIN_BIN_DIR "${GCC_TOOLCHAIN_PREFIX}/bin")
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR RISCV)
if(WIN32)
    set(TOOL_EXECUTABLE_SUFFIX ".exe")
else()
    set(TOOL_EXECUTABLE_SUFFIX "")
endif()

set(CMAKE_C_COMPILER "${TOOLCHAIN_BIN_DIR}/${TARGET_TRIPLET}-gcc${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "C compiler")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_BIN_DIR}/${TARGET_TRIPLET}-g++${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "C++ compiler")
set(CMAKE_ASM_COMPILER "${TOOLCHAIN_BIN_DIR}/${TARGET_TRIPLET}-gcc${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "assembler")
set(CMAKE_OBJCOPY "${TOOLCHAIN_BIN_DIR}/${TARGET_TRIPLET}-objcopy${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "objcopy tool")
set(CMAKE_OBJDUMP "${TOOLCHAIN_BIN_DIR}/${TARGET_TRIPLET}-objdump${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "objdump tool")
set(CMAKE_SIZE "${TOOLCHAIN_BIN_DIR}/${TARGET_TRIPLET}-size${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "size tool")
if(EXISTS "${TOOLCHAIN_BIN_DIR}/${TARGET_TRIPLET}-gcc-ar${TOOL_EXECUTABLE_SUFFIX}")
    set(CMAKE_AR "${TOOLCHAIN_BIN_DIR}/${TARGET_TRIPLET}-gcc-ar${TOOL_EXECUTABLE_SUFFIX}" CACHE FILEPATH "Archiver with LTO plugin")
    set(CMAKE_RANLIB "${TOOLCHAIN_BIN_DIR}/${TARGET_TRIPLET}-gcc-ranlib${TOOL_EXECUTABLE_SUFFIX}" CACHE FILEPATH "Ranlib with LTO plugin")
endif()

set(CMAKE_FIND_ROOT_PATH "${GCC_TOOLCHAIN_PREFIX}/${TARGET_TRIPLET}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
