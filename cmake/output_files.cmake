# Fall back to deriving toolchain utilities from the compiler or PATH
# when the toolchain file does not set them.
macro(_mupp_find_toolchain_tools)
    if(NOT CMAKE_SIZE)
        if(CMAKE_C_COMPILER MATCHES "gcc(\\.exe)?$")
            string(REGEX REPLACE "gcc$" "size" _size_tool "${CMAKE_C_COMPILER}")
            string(REGEX REPLACE "gcc\\.exe$" "size.exe" _size_tool "${_size_tool}")
        endif()
        find_program(CMAKE_SIZE NAMES ${_size_tool} arm-none-eabi-size size)
        if(NOT CMAKE_SIZE AND _size_tool)
            set(CMAKE_SIZE "${_size_tool}" CACHE FILEPATH "size")
        endif()
    endif()

    if(NOT CMAKE_OBJDUMP)
        if(CMAKE_C_COMPILER MATCHES "gcc(\\.exe)?$")
            string(REGEX REPLACE "gcc$" "objdump" _objdump_tool "${CMAKE_C_COMPILER}")
            string(REGEX REPLACE "gcc\\.exe$" "objdump.exe" _objdump_tool "${_objdump_tool}")
        endif()
        find_program(CMAKE_OBJDUMP NAMES ${_objdump_tool} arm-none-eabi-objdump objdump)
        if(NOT CMAKE_OBJDUMP AND _objdump_tool)
            set(CMAKE_OBJDUMP "${_objdump_tool}" CACHE FILEPATH "objdump")
        endif()
    endif()

    if(NOT CMAKE_CPPFILT)
        if(CMAKE_CXX_COMPILER MATCHES "g\\+\\+(\\.exe)?$")
            string(REGEX REPLACE "g\\+\\+$" "c++filt" _cppfilt_tool "${CMAKE_CXX_COMPILER}")
            string(REGEX REPLACE "g\\+\\+\\.exe$" "c++filt.exe" _cppfilt_tool "${_cppfilt_tool}")
        elseif(CMAKE_C_COMPILER MATCHES "gcc(\\.exe)?$")
            string(REGEX REPLACE "gcc$" "c++filt" _cppfilt_tool "${CMAKE_C_COMPILER}")
            string(REGEX REPLACE "gcc\\.exe$" "c++filt.exe" _cppfilt_tool "${_cppfilt_tool}")
        endif()
        find_program(CMAKE_CPPFILT NAMES ${_cppfilt_tool} arm-none-eabi-c++filt c++filt)
        if(NOT CMAKE_CPPFILT AND _cppfilt_tool)
            set(CMAKE_CPPFILT "${_cppfilt_tool}" CACHE FILEPATH "c++filt")
        endif()
    endif()
endmacro()

_mupp_find_toolchain_tools()

FUNCTION(ADD_DUMP_TARGET TARGET)
_mupp_find_toolchain_tools()
IF(EXECUTABLE_OUTPUT_PATH)
  SET(FILENAME "${EXECUTABLE_OUTPUT_PATH}/${TARGET}")
ELSE()
  SET(FILENAME "$<TARGET_FILE:${TARGET}>")
ENDIF()
IF(CMAKE_OBJDUMP AND CMAKE_CPPFILT)
  ADD_CUSTOM_TARGET(${TARGET}.dump DEPENDS ${TARGET} COMMAND ${CMAKE_OBJDUMP} -x -D -S -s ${FILENAME} | ${CMAKE_CPPFILT} > ${TARGET}.dump)
ELSEIF(CMAKE_OBJDUMP)
  ADD_CUSTOM_TARGET(${TARGET}.dump DEPENDS ${TARGET} COMMAND ${CMAKE_OBJDUMP} -x -D -S -s ${FILENAME} > ${TARGET}.dump)
ENDIF()
ENDFUNCTION()

FUNCTION(PRINT_SIZE_OF_TARGETS TARGET)
_mupp_find_toolchain_tools()
IF(EXECUTABLE_OUTPUT_PATH)
  SET(FILENAME "${EXECUTABLE_OUTPUT_PATH}/${TARGET}")
ELSE()
  SET(FILENAME "$<TARGET_FILE:${TARGET}>")
ENDIF()
IF(CMAKE_SIZE)
  add_custom_command(TARGET ${TARGET} POST_BUILD COMMAND ${CMAKE_SIZE} ${FILENAME})
ENDIF()
ENDFUNCTION()
