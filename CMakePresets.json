{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc_arm.cmake"
    },
    {
      "name": "mini",
      "displayName": "Versaloon Mini",
      "inherits": "base",
      "cacheVariables": { "BOARD": "mini" }
    },
    {
      "name": "otheruse",
      "displayName": "OtherUse",
      "inherits": "base",
      "cacheVariables": { "BOARD": "otheruse" }
    },
    {
      "name": "stlinkv21",
      "displayName": "ST-Link/V2-1 (Nucleo)",
      "inherits": "base",
      "cacheVariables": { "BOARD": "stlinkv21" }
    },
    {
      "name": "stlinkv2miniclone",
      "displayName": "ST-Link/V2 mini clone",
      "inherits": "base",
      "cacheVariables": { "BOARD": "stlinkv2miniclone" }
    },
    {
      "name": "host-tests",
      "displayName": "Host unit tests",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "MUPP_HOST_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "mini", "configurePreset": "mini" },
    { "name": "otheruse", "configurePreset": "otheruse" },
    { "name": "stlinkv21", "configurePreset": "stlinkv21" },
    { "name": "stlinkv2miniclone", "configurePreset": "stlinkv2miniclone" },
    { "name": "host-tests", "configurePreset": "host-tests" }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": { "outputOnFailure": true }
    }
  ]
}
